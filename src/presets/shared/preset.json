{
  "name": "shared",
  "description": "Common artifacts included in every project preset",
  "includes": [],
  "artifacts": {
    "skills": [
      "ak-git",
      "ak-code-review",
      "ak-debug",
      "ak-test",
      "ak-sequential-thinking",
      "ak-scout",
      "ak-research",
      "ak-daily-report"
    ],
    "rules": [
      "development-rules.md",
      "documentation-management.md"
    ],
    "hooks": []
  },
  "settings": {
    "enabledPlugins": {
      "claude-mem@thedotmack": true,
      "qmd@qmd": true
    },
    "extraKnownMarketplaces": {
      "thedotmack": {
        "source": {
          "source": "github",
          "repo": "thedotmack/claude-mem"
        }
      },
      "qmd": {
        "source": {
          "source": "github",
          "repo": "tobi/qmd"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--extension"]
    },
    "agent-browser": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/agent-browser@latest"]
    }
  },
  "dependencies": {
    "scripts": []
  }
}
